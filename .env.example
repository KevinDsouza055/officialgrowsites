# .env.example — copy to .env (local) or set in your hosting provider
# Recommended: use SendGrid for reliable delivery

# SendGrid (recommended)
SENDGRID_API_KEY=
NOTIFY_EMAIL=
FROM_EMAIL=

# Fallback: Gmail (less recommended)
GMAIL_USER=
GMAIL_PASS=

# Optional: used by the server logging or tests
NODE_ENV=development
